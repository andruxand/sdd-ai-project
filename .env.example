# ──────────────────────────────────────────
# Environment variables — DO NOT use real values here
# Copy to .env and fill in per environment
# ──────────────────────────────────────────

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=your-profile

# Stage
STAGE=dev

# Observability (optional — uncomment if using Datadog)
# DD_API_KEY=
# DD_SITE=datadoghq.com

# API keys (injected via SSM in production)
# API_KEY=

# Database (if applicable)
# DB_TABLE_NAME=
