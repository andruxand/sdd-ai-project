name: GraphQL Contract Check
on:
  pull_request:
    paths:
      - 'packages/contracts/**'
      - 'services/api/src/**'
jobs:
  graphql-contract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - name: Check schema exists
        id: check
        run: echo "exists=$([[ -f packages/contracts/graphql/schema.graphql ]] && echo true || echo false)" >> "$GITHUB_OUTPUT"
      - name: Validate GraphQL schema
        if: steps.check.outputs.exists == 'true'
        run: |
          node --input-type=module -e "
            import { buildSchema } from 'graphql';
            import { readFileSync, readdirSync } from 'fs';
            import { join } from 'path';
            const dir = 'packages/contracts/graphql';
            function collectFiles(d, acc = []) {
              for (const e of readdirSync(d, { withFileTypes: true })) {
                if (e.isDirectory()) collectFiles(join(d, e.name), acc);
                else if (e.name.endsWith('.graphql')) acc.push(join(d, e.name));
              }
              return acc;
            }
            const files = collectFiles(dir).sort();
            const merged = files.map(f => readFileSync(f, 'utf8')).join('\n');
            buildSchema(merged);
            console.log('Schema valid - ' + files.length + ' file(s).');
          "
      - name: Diff schema against main
        if: steps.check.outputs.exists == 'true'
        run: |
          git show origin/main:packages/contracts/graphql/schema.graphql > /tmp/schema-main.graphql 2>/dev/null || echo "No previous schema found — skipping diff."
          if [ -f /tmp/schema-main.graphql ]; then
            npx graphql-inspector diff /tmp/schema-main.graphql packages/contracts/graphql/schema.graphql
          fi
